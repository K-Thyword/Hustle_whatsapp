# Shared password gate — one password for you + the 3 agents, no
# per-user accounts yet. Pick something you're comfortable sharing.
ADMIN_DASHBOARD_PASSWORD=

# Random long string used to sign the session cookie. Any random value
# works — generate one with: openssl rand -hex 32
SESSION_SECRET=

# Google Sheets — same spreadsheet the WhatsApp bot logs to. This service
# only ever READS from it, never writes. Duplicate the exact same three
# values you already set on the hustleapp-whatsapp service.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Anthropic — powers the Reports tab's AI-written weekly summary. Optional:
# without it, Reports still works, just with a plain computed summary
# instead of an AI-written one. Duplicate from the bot service if you want
# the AI version.
ANTHROPIC_API_KEY=

# Agent display names — same format and same values as the bot service's
# AGENT_NAMES var: "phone:Name,phone:Name". Used to label the Agents tab
# and the "claimed by" column instead of showing raw phone numbers.
AGENT_NAMES=

# Weekly WhatsApp digest — sent automatically to agents every Monday 8am.
# Optional: without these, the digest still works in the Reports tab, it
# just won't get sent over WhatsApp. Uses its OWN copy of the Meta
# credentials (not shared at runtime with the bot service) so this service
# stays fully independent.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
AGENT_NOTIFY_NUMBERS=
# Requires a template named this (or set here) to exist and be APPROVED in
# Meta Business Manager first — Category: Utility, Body: one variable,
# e.g. "Hustleapp weekly summary: {{1}}". Language must match exactly what
# you pick when creating it in Meta (en_US = "English (US)", NOT "English").
WEEKLY_DIGEST_TEMPLATE_NAME=hustle_weekly_digest
WEEKLY_DIGEST_TEMPLATE_LANGUAGE=en_US

PORT=3001
