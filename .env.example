# Meta / WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=choose-a-random-string-yourself
WHATSAPP_ACCESS_TOKEN=from-meta-business-manager
WHATSAPP_PHONE_NUMBER_ID=from-meta-business-manager
WHATSAPP_BUSINESS_ACCOUNT_ID=from-meta-business-manager

# Backend app API (from the requirements doc sent to the app dev team)
APP_API_BASE_URL=https://api.hustleapp.example
APP_API_KEY=

# Anthropic (for the intent router / general-question answering)
ANTHROPIC_API_KEY=from-console.anthropic.com

# OpenAI (Whisper — transcribes customer voice notes so orders can be
# placed by speaking instead of typing). Leave unset to disable voice
# notes entirely; the bot will just ask the sender to type instead.
OPENAI_API_KEY=from-platform.openai.com

# Interim: agent phone numbers notified over WhatsApp when a booking request
# is submitted, until a real backend/dashboard exists. Digits only, no "+".
AGENT_NOTIFY_NUMBERS=233556963137,233556937198

# Redis — persists this service's OWN runtime state (sessions, quote
# requests, live chats, agent notification queues) so a crash or redeploy
# doesn't wipe every conversation in flight. This is NOT the main
# Hustleapp database — just this bot's operational memory. Leave unset to
# fall back to in-memory storage (fine for local dev; on Railway it means
# state resets on every deploy, same as before this was added).
REDIS_URL=

PORT=3000
