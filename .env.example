# Meta / WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=choose-a-random-string-yourself
WHATSAPP_ACCESS_TOKEN=from-meta-business-manager
WHATSAPP_PHONE_NUMBER_ID=from-meta-business-manager
WHATSAPP_BUSINESS_ACCOUNT_ID=from-meta-business-manager

# Backend app API (from the requirements doc sent to the app dev team)
APP_API_BASE_URL=https://api.hustleapp.example
APP_API_KEY=

# Anthropic (for the intent router / general-question answering)
ANTHROPIC_API_KEY=from-console.anthropic.com

# OpenAI (Whisper — transcribes customer voice notes so orders can be
# placed by speaking instead of typing). Leave unset to disable voice
# notes entirely; the bot will just ask the sender to type instead.
OPENAI_API_KEY=from-platform.openai.com

# Interim: agent phone numbers notified over WhatsApp when a booking request
# is submitted, until a real backend/dashboard exists. Digits only, no "+".
AGENT_NOTIFY_NUMBERS=233556963137,233556937198

# WhatsApp templates for proactive (business-initiated) sends. Each must be
# created and approved in Meta Business Manager > WhatsApp Manager > Message
# Templates before that feature will actually deliver anything — until then,
# the send just fails and logs an error, same graceful-failure pattern as
# every other template send in this app.
#
# Marketing category — used for the "broadcast: <message>" agent command and
# the 30-day win-back check-in. Only ever sent to customers who've opted in.
#   Body: "Hustleapp: {{1}}\n\nReply STOP to opt out of these updates."
MARKETING_TEMPLATE_NAME=hustle_marketing_update
MARKETING_TEMPLATE_LANGUAGE=en_US

# Utility category — fires a customer's own reminder. No opt-in required,
# since the customer explicitly asked for this specific message.
#   Body: "⏰ Reminder from Hustleapp: {{1}}. Want help booking this now? Just reply YES."
REMINDER_TEMPLATE_NAME=hustle_reminder
REMINDER_TEMPLATE_LANGUAGE=en_US

# Utility category — lets an agent reach a customer whose 24h window has
# closed (a live chat that went quiet, or a "matched"/quote/done update
# that lands later than expected). The real message is queued and
# delivered as soon as the customer replies to this.
#   Body: "Hustleapp: you have {{1}} waiting. Reply to this message to see the details."
CUSTOMER_NOTIFICATION_TEMPLATE_NAME=hustle_customer_notification
CUSTOMER_NOTIFICATION_TEMPLATE_LANGUAGE=en_US

# Google Sheets — optional shared activity log (booking events, delivery
# failure alerts, and full conversation transcripts). Leave unset to quietly
# no-op (logs to console instead); nothing else in the app depends on this.
# Setup: see the header comment in src/googleSheet.ts. Needs a spreadsheet
# with TWO tabs — "Sheet1" (events/alerts) and "Transcripts" (every inbound
# customer message + every message the customer receives, for reviewing
# what conversations actually look like — see logTranscriptLine).
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Redis — persists this service's OWN runtime state (sessions, quote
# requests, live chats, agent notification queues) so a crash or redeploy
# doesn't wipe every conversation in flight. This is NOT the main
# Hustleapp database — just this bot's operational memory. Leave unset to
# fall back to in-memory storage (fine for local dev; on Railway it means
# state resets on every deploy, same as before this was added).
REDIS_URL=

PORT=3000
